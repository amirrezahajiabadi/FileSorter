# ==============================================================================
#  FileSorter — Repository .gitignore
# ==============================================================================

# ── Node / Vite / TypeScript ──────────────────────────────────────────────────
node_modules/
dist/
dist-ssr/
*.local
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ── Rust / Cargo / Tauri ──────────────────────────────────────────────────────
target/
src-tauri/target/
src-tauri/gen/schemas/
**/*.rs.bk

# ── Environment & local overrides ─────────────────────────────────────────────
.env
.env.local
.env.*.local
*.env

# ── Application runtime data ──────────────────────────────────────────────────
.filesorter_settings.json
*.log
logs/
*.tmp
*.bak
*.swp
*.swo

# ── Build & packaging output ──────────────────────────────────────────────────
Release/
*.exe
*.msi
*.dll
*.so
*.dylib
!src-tauri/icons/*

# ── Operating system artifacts ────────────────────────────────────────────────
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
[Dd]esktop.ini
$RECYCLE.BIN/
*.stackdump
.DS_Store
.AppleDouble
.LSOverride
._*
.DocumentRevisions-V100
.fseventsd
.Spotlight-V100
.TemporaryItems
.Trashes
*~
.directory

# ── IDEs & editors ────────────────────────────────────────────────────────────
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
